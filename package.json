{
  "name": "productops-mcp",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/copy-skills.mjs && tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty",
    "test": "pnpm build && vitest run",
    "test:unit": "vitest run --project unit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "client": "node scripts/test-client.mjs",
    "coverage": "vitest run --project unit --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
